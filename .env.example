# ============================================
# Backend (Django)
# ============================================

# Chave secreta (gerar com: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=

# Modo debug (True para dev, False para produção)
DEBUG=True

# ============================================
# Banco de Dados
# ============================================

# Nome do banco
DB_NAME=autogestor

# Usuário do banco
DB_USER=autogestor

# Senha do banco (OBRIGATÓRIO para produção)
DB_PASSWORD=

# ============================================
# CORS e Hosts
# ============================================

# Origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,api

# ============================================
# Frontend (React/Vite)
# ============================================

# URL da API backend
VITE_API_URL=http://localhost:8000
