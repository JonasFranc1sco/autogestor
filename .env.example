# ============================================
# Backend (Django)
# ============================================

# Chave secreta (obrigatória quando DEBUG=False)
# Gerar com: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Modo debug (True para dev, False para produção)
DEBUG=True

# ============================================
# Banco de Dados
# ============================================

# Nome do banco
DB_NAME=autogestor

# Usuário do banco
DB_USER=autogestor

# Senha do banco (OBRIGATÓRIO para produção)
DB_PASSWORD=

# ============================================
# CORS e Hosts
# ============================================

# Origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,api

# ============================================
# E-mail (recuperação de senha)
# ============================================

# Backend de e-mail (padrão: console no desenvolvimento)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@autogestor.local

# URL do front usada nos links de recuperação de senha
PASSWORD_RESET_URL=http://localhost:3000/recuperar-senha


# Limites de requisição (padrão seguro para produção)
THROTTLE_AUTH=20/min
THROTTLE_LOOKUP=60/min

# ============================================
# Frontend (React/Vite)
# ============================================

# URL da API backend
VITE_API_URL=http://localhost:8000
