# Backend (Django)

# Chave secreta (gerar com: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=

# Modo debug (True para dev, False para produção)
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost,api

# Origens CORS permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Banco de Dados (se ausente, usa SQLite)
DATABASE_URL=
DB_NAME=autogestor
DB_USER=autogestor
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
