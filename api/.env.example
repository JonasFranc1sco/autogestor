# Backend (Django)

# Chave secreta (obrigatória quando DEBUG=False)
# Gerar com: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Modo debug (True para dev, False para produção)
DEBUG=True

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost,api

# Origens CORS permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Banco de Dados (se ausente, usa SQLite)
DATABASE_URL=
DB_NAME=autogestor
DB_USER=autogestor
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432


# ============================================
# E-mail (recuperação de senha)
# ============================================

# Backend de e-mail (padrão: console no desenvolvimento)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@autogestor.local

# URL do front usada nos links de recuperação de senha
PASSWORD_RESET_URL=http://localhost:3000/recuperar-senha
